# User-level systemd service for Kiki RSS
# Preferred: run `kiki service install` instead of copying this manually.
# Manual install: copy to ~/.config/systemd/user/kiki.service

[Unit]
Description=Kiki RSS feed aggregator (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/kiki
ExecStartPre=/usr/bin/kiki init --auto --check
ExecStart=/usr/bin/kiki serve
Restart=on-failure
RestartSec=5

# ----------------------------------------------------------------------
# Hardening (see systemd.exec(5)). Layered under the in-process Landlock
# + seccomp filters that `kiki serve` installs on startup. Some options
# available in system units (User=, PrivateUsers=, ProtectHome=) are
# omitted here because they conflict with user-level execution or with
# keeping the data directory under $HOME accessible.
# ----------------------------------------------------------------------

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/kiki
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @debug @cpu-emulation @obsolete @raw-io @keyring
UMask=0077

[Install]
WantedBy=default.target
