# User-level systemd service for Kiki RSS
# Preferred: run `kiki systemd install` instead of copying this manually.
# Manual install: copy to ~/.config/systemd/user/kiki.service
#
# A user service stops when the user's last session ends, which also removes
# $XDG_RUNTIME_DIR and the socket inside it. Run `loginctl enable-linger $USER`
# to keep kiki running between logins.

[Unit]
Description=Kiki RSS feed aggregator (user)
After=default.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/kiki

# With no $KIKI_HOME set, `kiki serve` resolves the platform data directory
# for its database and defaults its socket to $XDG_RUNTIME_DIR/kiki/kiki.sock,
# which ProtectSystem=strict below would otherwise leave read-only.
# RuntimeDirectory= also has systemd create it with the right mode and clean it
# up on stop. To run out of a different directory, set Environment=KIKI_HOME=...
# instead — the socket then lives in that directory and this stanza is
# unnecessary.
RuntimeDirectory=kiki
RuntimeDirectoryMode=0700

ExecStartPre=/usr/bin/kiki init --check
ExecStart=/usr/bin/kiki serve
Restart=on-failure
RestartSec=5

# ----------------------------------------------------------------------
# Hardening (see systemd.exec(5)). Layered under the in-process Landlock
# + seccomp filters that `kiki serve` installs on startup. Some options
# available in system units (User=, PrivateUsers=, ProtectHome=) are
# omitted here because they conflict with user-level execution or with
# keeping the data directory under $HOME accessible.
# ----------------------------------------------------------------------

NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=%h/.local/share/kiki
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
# @sandbox (landlock_* and seccomp) lets kiki install its own sandbox;
# @system-service alone doesn't include it.
SystemCallFilter=@system-service @sandbox
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @debug @cpu-emulation @obsolete @raw-io @keyring
UMask=0077

[Install]
WantedBy=default.target
