# Maintainer: kernelmethod
pkgname=kiki
pkgver=${PKGVER:-0.2.0}
pkgrel=1
pkgdesc="An RSS feed aggregator"
arch=('x86_64')
url="https://github.com/kernelmethod/kiki-rss"
license=('MIT')
depends=('gcc-libs' 'systemd')
makedepends=('cargo')
# Keep makepkg from adding -flto=auto to CFLAGS/CXXFLAGS/LDFLAGS. Build
# scripts such as aws-lc-sys compile and link probe programs with these
# flags, and the resulting GCC LTO objects fail to link.
# The release profile already strips the binary, so the debug package makepkg
# splits out by default would be empty.
options=('!lto' '!debug')
install=kiki.install
source=()

# Set KIKI_BINARY to the path of a prebuilt kiki binary (e.g. the static
# musl release build) to package it instead of building from source. A
# relative path is resolved from the repository root. Pass --nodeps to
# makepkg in that case if cargo isn't installed.
build() {
    if [[ -n $KIKI_BINARY ]]; then
        return 0
    fi
    cd "$startdir/.."
    # Belt-and-braces with options=('!lto'): disable GCC LTO for C code
    # compiled by vendored build scripts (zstd-sys, libsqlite3-sys,
    # mlua-sys, aws-lc-sys) in case makepkg.conf puts -flto in CFLAGS
    # directly. GCC GIMPLE LTO objects can't be processed by Rust's lld
    # linker, causing undefined symbol errors.
    export CFLAGS+=" -fno-lto"
    export CXXFLAGS+=" -fno-lto"
    cargo build --release --locked
}

package() {
    cd "$startdir/.."
    install -Dm755 "${KIKI_BINARY:-target/release/kiki}" "$pkgdir/usr/bin/kiki"
    install -Dm644 "dist/kiki.service" "$pkgdir/usr/lib/systemd/system/kiki.service"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/kiki-rss/README.md"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
