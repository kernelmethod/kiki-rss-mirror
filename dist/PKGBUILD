# Maintainer: kernelmethod
pkgname=kiki
pkgver=${PKGVER:-0.2.0}
pkgrel=1
pkgdesc="An RSS feed aggregator"
arch=('x86_64')
url="https://github.com/kernelmethod/kiki-rss"
license=('MIT')
depends=('gcc-libs' 'systemd')
makedepends=('cargo' 'openssl')
install=kiki.install
source=()

build() {
    cd "$startdir/.."
    # Disable GCC LTO for C code compiled by vendored build scripts
    # (zstd-sys, libsqlite3-sys, mlua-sys). Arch's makepkg.conf adds
    # -flto=auto to CFLAGS, which produces GCC GIMPLE LTO objects that
    # Rust's lld linker cannot process, causing undefined symbol errors.
    export CFLAGS+=" -fno-lto"
    export CXXFLAGS+=" -fno-lto"
    cargo build --release --locked
}

package() {
    cd "$startdir/.."
    install -Dm755 "target/release/kiki" "$pkgdir/usr/bin/kiki"
    install -Dm644 "dist/kiki.service" "$pkgdir/usr/lib/systemd/system/kiki.service"
    install -Dm644 "README.md" "$pkgdir/usr/share/doc/kiki-rss/README.md"
    install -Dm644 "LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
