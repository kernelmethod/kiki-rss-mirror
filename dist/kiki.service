[Unit]
Description=Kiki RSS feed aggregator
After=network.target

[Service]
Type=simple
User=kiki
Group=kiki
WorkingDirectory=/var/lib/kiki
RuntimeDirectory=kiki
RuntimeDirectoryMode=0750
Environment=KIKI_HOME=/var/lib/kiki
ExecStartPre=/usr/bin/kiki init --check
ExecStart=/usr/bin/kiki serve --uds /run/kiki/kiki.sock
Restart=on-failure
RestartSec=5

# ----------------------------------------------------------------------
# Hardening (see systemd.exec(5)). Layered under the in-process Landlock
# + seccomp filters that `kiki serve` installs on startup. Directives
# that would break the service's legitimate behaviour (outbound HTTPS
# feed fetches, writes to /var/lib/kiki, creating /run/kiki/kiki.sock)
# are deliberately omitted or carved out.
# ----------------------------------------------------------------------

# Identity / privileges
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=

# Filesystem
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kiki
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectClock=yes
ProtectProc=invisible

# Namespaces
PrivateIPC=yes
PrivateUsers=yes
RestrictNamespaces=yes

# Network: Unix socket for the local API, IPv4/IPv6 for outbound feed
# fetches. AF_NETLINK and everything else are denied.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Syscalls (outer belt; the in-process seccomp filter adds more).
# @sandbox (landlock_* and seccomp) is not part of @system-service, but
# every kiki process needs it to install its own Landlock and seccomp
# filters; without it systemd kills `kiki serve` with SIGSYS on startup.
SystemCallArchitectures=native
SystemCallFilter=@system-service @sandbox
SystemCallFilter=~@privileged @resources @mount @swap @reboot @module @debug @cpu-emulation @obsolete @raw-io @keyring

# Memory & execution
MemoryDenyWriteExecute=yes
LockPersonality=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes

# Misc
UMask=0077
KeyringMode=private
RemoveIPC=yes

[Install]
WantedBy=multi-user.target
