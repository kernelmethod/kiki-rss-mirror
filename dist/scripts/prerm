#!/bin/sh
set -e

case "$1" in
    remove|purge)
        # Stop the service if running
        if systemctl is-active --quiet kiki.service 2>/dev/null; then
            systemctl stop kiki.service
        fi
        if systemctl is-enabled --quiet kiki.service 2>/dev/null; then
            systemctl disable kiki.service
        fi
        ;;
esac
