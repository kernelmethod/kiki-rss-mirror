post_install() {
    # Create system group and user
    if ! getent group kiki >/dev/null 2>&1; then
        groupadd --system kiki
    fi
    if ! getent passwd kiki >/dev/null 2>&1; then
        useradd --system --gid kiki --home-dir /var/lib/kiki \
            --shell /usr/sbin/nologin --no-create-home kiki
    fi

    # Create and set ownership on data directory
    install -d -m 0750 -o kiki -g kiki /var/lib/kiki

    # Initialize the database (idempotent)
    su -s /bin/sh kiki -c 'KIKI_HOME=/var/lib/kiki /usr/bin/kiki init --check'

    # Reload systemd
    systemctl daemon-reload

    echo ":: Enable and start the service with:"
    echo "   systemctl enable --now kiki.service"
}

post_upgrade() {
    post_install
}

pre_remove() {
    # Stop and disable service
    if systemctl is-active --quiet kiki.service 2>/dev/null; then
        systemctl stop kiki.service
    fi
    if systemctl is-enabled --quiet kiki.service 2>/dev/null; then
        systemctl disable kiki.service
    fi
}
